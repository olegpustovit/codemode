      "css": ".ds-nav{display:flex;flex-direction:column;gap:2px}.ds-nav a{position:relative;display:flex;align-items:center;min-height:36px;padding:0 12px;color:var(--c-text-2);font:500 14px var(--f-ui);text-decoration:none;transition:color var(--t-1),background var(--t-1)}.ds-nav a:hover{color:var(--c-text);background:var(--c-hover)}.ds-nav a[aria-current=page]{color:var(--c-text);background:linear-gradient(90deg,rgba(var(--hue),.26),rgba(var(--hue),.04))}.ds-nav a[aria-current=page]::before{content:\"\";position:absolute;left:0;top:6px;bottom:6px;width:2px;background:var(--c-accent-text);box-shadow:var(--glow-1)}.ds-nav a:focus-visible{outline:2px solid var(--c-accent-text);outline-offset:2px}@media(max-width:767px){.ds-nav{flex-direction:row;overflow-x:auto}.ds-nav a{flex:none}}@media(prefers-reduced-motion:reduce){.ds-nav{transition:none!important}}"
