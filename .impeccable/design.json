  "narrative": {
    "northStar": "The approved transparent control plane",
    "overview": "The owner-approved control-plane proposal is the visual authority: [proposal](https://artifacts.microapps.space/a/hkwwwp90n0dt), preserved in `docs/proposal/control-plane.html`. Its final v5 overrides supersede the earlier daytime design. This document records the implemented replacement; release qualification is recorded separately in `docs/proposal/implementation.md`.\n\nThe interface is an Operate surface. Compact lists, readable code, explicit connection states and a visible path through stacked panes carry the work. A continuous ribbon shader sits behind transparent work regions, with cobalt, violet, teal, bronze and crimson section hues. Raster decoration is not used.",
    "keyCharacteristics": [
      "Transparent square work surfaces",
      "One moving list cursor and tab underline",
      "Self-hosted M PLUS 1p and JetBrains Mono",
      "Visible state and precise recovery"
    ],
    "rules": [
      {
        "name": "Final Override",
        "body": "The final ground, transparent surfaces, line opacities and accent mix override the earlier base declarations in the stylesheet. Do not copy the earlier base declarations in isolation.",
        "section": "colors"
      },
      {
        "name": "Transparent Work Region",
        "body": "Work panes stay transparent; small control and code backings retain their observed washes. The selected list cursor and current section have a restrained hue wash; key focus and selected boundaries use small accent glows. Text uses a slight offset shadow for legibility over the wave.",
        "section": "elevation"
      },
      {
        "name": "One Cursor",
        "body": "Each data grid shares one moving selection cursor; each tab bar shares one underline.",
        "section": "components"
      }
    ],
    "dos": [
      "Do follow the exact proposal and final v5 overrides when extending the system.",
      "Do preserve keyboard focus, reduced motion, tenant boundaries, write-only secrets and precise errors.",
      "Do show real connection and execution state; use explicit loading, empty and failure treatments."
    ],
    "donts": [
      "Don't reintroduce opaque cards, rounded work surfaces, pills, sidebar sheets, toasts or approval dialogs.",
      "Don't replace the proposal shader, fonts, glyph geometry or section hues with a new direction.",
      "Don't claim provider consent, external-client acceptance or M-series performance from local fixtures."
    ]
  }
}
