      "css": ".ds-field-label{display:block;margin-bottom:.5rem;font-size:.875rem;font-weight:500;line-height:1.375;font-family:'Geist Variable',sans-serif;}.ds-input{box-sizing:border-box;min-width:0;width:100%;height:2rem;padding:.25rem .625rem;border:1px solid var(--input);border-radius:var(--radius);background:transparent;color:var(--foreground);caret-color:var(--primary);font-size:1rem;line-height:1.5rem;outline:none;transition:color 150ms cubic-bezier(.4,0,.2,1),border-color 150ms cubic-bezier(.4,0,.2,1);font-family:'Geist Variable',sans-serif;}.ds-input::placeholder{color:var(--muted-foreground)}.ds-input:focus-visible{border-color:var(--ring);box-shadow:0 0 0 3px color-mix(in oklab,var(--ring) 50%,transparent)}.ds-input[aria-invalid=\"true\"]{border-color:var(--destructive);box-shadow:0 0 0 3px color-mix(in oklab,var(--destructive) 20%,transparent)}.ds-input:disabled{pointer-events:none;cursor:not-allowed;background:color-mix(in oklab,var(--input) 50%,transparent);opacity:.5}@media(min-width:48rem){.ds-input{font-size:.875rem;line-height:1.25rem}}"
