      "html": "<button class=\"ds-button-primary\" type=\"button\">Save changes</button>",
      "css": ".ds-button-primary{display:inline-flex;align-items:center;justify-content:center;flex-shrink:0;gap:.375rem;box-sizing:border-box;height:2rem;padding:0 .625rem;border:1px solid transparent;border-radius:var(--radius);font-size:.875rem;font-weight:500;line-height:1.25rem;white-space:nowrap;user-select:none;transition:all 150ms cubic-bezier(.4,0,.2,1);outline:none;font-family:'Geist Variable',sans-serif;background:var(--primary);color:var(--primary-foreground);}.ds-button-primary:hover{background:color-mix(in oklab,var(--primary) 80%,transparent);}.ds-button-primary:focus-visible{border-color:var(--ring);box-shadow:0 0 0 3px color-mix(in oklab,var(--ring) 50%,transparent);}.ds-button-primary:active{transform:translateY(1px);}.ds-button-primary:disabled{pointer-events:none;opacity:.5;}"
