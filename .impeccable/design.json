      "css": ".ds-policy{display:inline-flex;align-items:center;gap:8px;border:0;padding:0;background:transparent;color:var(--c-text);font:400 13px var(--f-ui);cursor:pointer}.ds-policy i{position:relative;width:26px;height:14px;border:1px solid var(--c-line-2);background:rgba(255,255,255,.04)}.ds-policy i::after{content:\"\";position:absolute;top:2px;left:13px;width:9px;height:8px;background:var(--c-text);transition:left var(--t-2) var(--e-out)}.ds-policy[aria-pressed=false] i::after{left:2px;background:var(--c-bad)}.ds-policy:focus-visible{outline:2px solid var(--c-accent-text);outline-offset:2px}.ds-policy:disabled{cursor:default;opacity:.6}@media(prefers-reduced-motion:reduce){.ds-policy{transition:none!important}}"
