  "query": "SELECT s.id,s.name,s.description FROM saved_scripts s JOIN endpoints e ON e.tenant_id=s.tenant_id WHERE e.id=$1 AND (s.endpoint_id=e.id OR s.endpoint_id IS NULL) AND ($2='' OR s.search @@ websearch_to_tsquery('simple',$2)) ORDER BY ts_rank(s.search,websearch_to_tsquery('simple',$2)) DESC,s.name,s.id LIMIT 20",
