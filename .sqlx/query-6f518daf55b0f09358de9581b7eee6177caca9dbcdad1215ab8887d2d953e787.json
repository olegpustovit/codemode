{
  "db_name": "PostgreSQL",
  "query": "SELECT id,token_id,session_id,title,status,error,tool_calls,code,result,output,\n            to_char(started_at AT TIME ZONE 'UTC','YYYY-MM-DD\"T\"HH24:MI:SS.US\"Z\"') AS \"started_at!\",\n            to_char(finished_at AT TIME ZONE 'UTC','YYYY-MM-DD\"T\"HH24:MI:SS.US\"Z\"') AS finished_at\n            FROM executions WHERE id=ANY($1) AND (session_id IS NULL OR EXISTS(SELECT 1 FROM agent_sessions s WHERE s.id=session_id AND s.expires_at>now())) ORDER BY started_at DESC,id DESC",
