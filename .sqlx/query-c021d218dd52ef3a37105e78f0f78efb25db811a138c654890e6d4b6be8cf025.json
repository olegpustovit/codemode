  "query": "SELECT CASE WHEN s.kind='openapi' THEN s.config->>'serverUrl' ELSE s.config->>'url' END AS server,a.kind,a.ciphertext,a.nonce,a.key_id FROM sources s LEFT JOIN accounts a ON a.source_id=s.id WHERE s.id=$1 AND s.kind IN ('openapi','graphql')",
