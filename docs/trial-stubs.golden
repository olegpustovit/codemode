## researcher.rank_titles
async def tools.researcher.rank_titles(*, titles: None | list[str], abstracts: None | list[str] = None, corpus: str = None, piece: str = None, track: str = None, venue: str = None) -> researcher_rank_titles_result: ...
# Rank one to twenty titles. With corpus=hn: the verified active HN title model, fitted-sample percentiles and validation metadata. With venue (and optional track) instead of corpus: compare titles, with optional parallel abstracts, to that venue stored accepted items (needs at least 10, for example added with add_corpus_items). Under venue_comparison each candidate has a meaning section (primary, and the order of candidates): cosine similarity of local sentence embeddings of the title plus abstract, the 5 nearest accepted items, and the percentile of the nearest similarity among accepted items; meaning.computed=false with a reason when the embedder is unavailable. The embedding model (BAAI/bge-small-en-v1.5) runs locally with no Jev or paid call; first use of a venue embeds and caches its accepted items, so that call is slower. Secondary lexical output: word-overlap neighbours and percentiles, title length and shape percentiles, vocabulary overlap, accepted items per year, and a list of what was not computed. With piece (one title and a non-empty abstract), the run is also saved on that piece's rankings and run_id is returned. Meaning is similarity to past accepted work, not acceptance odds. Neither path invents abstracts or calls Jev; both log titles and scores to the rank log.
from typing import Any, Literal, NotRequired, TypedDict

researcher_rank_titles_result_config_pins = TypedDict("researcher_rank_titles_result_config_pins", {"content_sha256": str, "key": str, "kind": str, "version": int})

researcher_rank_titles_result_model = TypedDict("researcher_rank_titles_result_model", {"class_key": str, "class_scope": str, "fit_samples": int, "kind": str, "r2_key": str, "sha256": str, "validation_key": str, "validation_sha256": str, "version": str})

researcher_rank_titles_result_ranked_score_contributions_logit = TypedDict("researcher_rank_titles_result_ranked_score_contributions_logit", {"contribution": float, "feature": str, "value": float})

researcher_rank_titles_result_ranked_score = TypedDict("researcher_rank_titles_result_ranked_score", {"contributions_logit": None | list[researcher_rank_titles_result_ranked_score_contributions_logit], "evaluation": Any, "interpretation": str, "mode": str, "n_fit": int, "percentile_among_contrast": float, "percentile_among_success": float, "score": float, "version": int})

researcher_rank_titles_result_ranked = TypedDict("researcher_rank_titles_result_ranked", {"index": int, "score": researcher_rank_titles_result_ranked_score, "title": str})

researcher_rank_titles_result_venue_comparison_ranked_meaning_nearest = TypedDict("researcher_rank_titles_result_venue_comparison_ranked_meaning_nearest", {"item": str, "similarity": float, "title": str, "url": NotRequired[str], "year": NotRequired[int]})

researcher_rank_titles_result_venue_comparison_ranked_meaning = TypedDict("researcher_rank_titles_result_venue_comparison_ranked_meaning", {"accepted_leave_one_out_top1_median": float, "computed": bool, "model": NotRequired[str], "n_compared": int, "nearest": NotRequired[None | list[researcher_rank_titles_result_venue_comparison_ranked_meaning_nearest]], "percentile_note": NotRequired[str], "percentile_of_top1_among_accepted": float, "reason": NotRequired[str], "top1_similarity": float, "top3_mean_similarity": float})

researcher_rank_titles_result_venue_comparison_ranked_title_abstract_vs_accepted_abstracts_nearest = TypedDict("researcher_rank_titles_result_venue_comparison_ranked_title_abstract_vs_accepted_abstracts_nearest", {"item": str, "similarity": float, "title": str, "url": NotRequired[str], "year": NotRequired[int]})

researcher_rank_titles_result_venue_comparison_ranked_title_abstract_vs_accepted_abstracts = TypedDict("researcher_rank_titles_result_venue_comparison_ranked_title_abstract_vs_accepted_abstracts", {"accepted_leave_one_out_top1_median": float, "computed": bool, "model": NotRequired[str], "n_compared": int, "nearest": NotRequired[None | list[researcher_rank_titles_result_venue_comparison_ranked_title_abstract_vs_accepted_abstracts_nearest]], "percentile_note": NotRequired[str], "percentile_of_top1_among_accepted": float, "reason": NotRequired[str], "top1_similarity": float, "top3_mean_similarity": float})

researcher_rank_titles_result_venue_comparison_ranked_title_shape = TypedDict("researcher_rank_titles_result_venue_comparison_ranked_title_shape", {"accepted_chars_median": float, "accepted_share_question": float, "accepted_share_with_colon": float, "accepted_share_with_digit": float, "accepted_words_median": float, "chars": int, "chars_percentile": float, "has_colon": bool, "has_digit": bool, "is_question": bool, "words": int, "words_percentile": float})

researcher_rank_titles_result_venue_comparison_ranked_title_vs_accepted_titles_nearest = TypedDict("researcher_rank_titles_result_venue_comparison_ranked_title_vs_accepted_titles_nearest", {"item": str, "similarity": float, "title": str, "url": NotRequired[str], "year": NotRequired[int]})

researcher_rank_titles_result_venue_comparison_ranked_title_vs_accepted_titles = TypedDict("researcher_rank_titles_result_venue_comparison_ranked_title_vs_accepted_titles", {"accepted_leave_one_out_top1_median": float, "computed": bool, "model": NotRequired[str], "n_compared": int, "nearest": NotRequired[None | list[researcher_rank_titles_result_venue_comparison_ranked_title_vs_accepted_titles_nearest]], "percentile_note": NotRequired[str], "percentile_of_top1_among_accepted": float, "reason": NotRequired[str], "top1_similarity": float, "top3_mean_similarity": float})

researcher_rank_titles_result_venue_comparison_ranked_vocabulary = TypedDict("researcher_rank_titles_result_venue_comparison_ranked_vocabulary", {"content_words": int, "seen_in_accepted_titles": int, "unseen_words": NotRequired[None | list[str]]})

researcher_rank_titles_result_venue_comparison_ranked = TypedDict("researcher_rank_titles_result_venue_comparison_ranked", {"index": int, "meaning": researcher_rank_titles_result_venue_comparison_ranked_meaning, "title": str, "title_abstract_vs_accepted_abstracts": researcher_rank_titles_result_venue_comparison_ranked_title_abstract_vs_accepted_abstracts, "title_shape": researcher_rank_titles_result_venue_comparison_ranked_title_shape, "title_vs_accepted_titles": researcher_rank_titles_result_venue_comparison_ranked_title_vs_accepted_titles, "vocabulary": researcher_rank_titles_result_venue_comparison_ranked_vocabulary})

researcher_rank_titles_result_venue_comparison = TypedDict("researcher_rank_titles_result_venue_comparison", {"accepted_per_year": None | dict[str, Any], "interpretation": str, "method": str, "n_accepted": int, "n_accepted_with_abstract": int, "not_computed": None | list[str], "ranked": None | list[researcher_rank_titles_result_venue_comparison_ranked], "track": NotRequired[str], "venue": str})

researcher_rank_titles_result = TypedDict("researcher_rank_titles_result", {"config_pins": None | list[researcher_rank_titles_result_config_pins], "input_sha256": str, "interpretation": str, "model": None | researcher_rank_titles_result_model, "model_version": str, "ranked": None | list[researcher_rank_titles_result_ranked], "run_id": NotRequired[str], "venue_comparison": NotRequired[None | researcher_rank_titles_result_venue_comparison]})
async def tools.researcher.rank_titles(*, titles: None | list[str], abstracts: None | list[str] = None, corpus: str = None, piece: str = None, track: str = None, venue: str = None) -> researcher_rank_titles_result: ...
# Rank one to twenty titles. With corpus=hn: the verified active HN title model, fitted-sample percentiles and validation metadata. With venue (and optional track) instead of corpus: compare titles, with optional parallel abstracts, to that venue stored accepted items (needs at least 10, for example added with add_corpus_items). Under venue_comparison each candidate has a meaning section (primary, and the order of candidates): cosine similarity of local sentence embeddings of the title plus abstract, the 5 nearest accepted items, and the percentile of the nearest similarity among accepted items; meaning.computed=false with a reason when the embedder is unavailable. The embedding model (BAAI/bge-small-en-v1.5) runs locally with no Jev or paid call; first use of a venue embeds and caches its accepted items, so that call is slower. Secondary lexical output: word-overlap neighbours and percentiles, title length and shape percentiles, vocabulary overlap, accepted items per year, and a list of what was not computed. With piece (one title and a non-empty abstract), the run is also saved on that piece's rankings and run_id is returned. Meaning is similarity to past accepted work, not acceptance odds. Neither path invents abstracts or calls Jev; both log titles and scores to the rank log.

## researcher.read_item
async def tools.researcher.read_item(*, item: str, venue: str, section: str = None) -> researcher_read_item_result: ...
# Read one corpus item's metadata and, when the private text store has it, one Markdown section (default _full, capped per response). Third-party text is private and shown only to authenticated agents. When text is absent or the store is unavailable the result has status unavailable with a reason and the outline of sections that do exist; no text is invented and no public copy is substituted.
from typing import Any, Literal, NotRequired, TypedDict

researcher_read_item_result_metadata = TypedDict("researcher_read_item_result_metadata", {"abstract": NotRequired[str], "authors": None | list[str], "doi": NotRequired[str], "item": str, "language": NotRequired[str], "read_depth_label": NotRequired[str], "text_reference_recorded": bool, "title": str, "track": NotRequired[str], "type": NotRequired[str], "url": NotRequired[str], "venue": str, "year": NotRequired[int]})

researcher_read_item_result_sections = TypedDict("researcher_read_item_result_sections", {"chunks": int, "id": str, "order": int})

researcher_read_item_result_source = TypedDict("researcher_read_item_result_source", {"access_basis": str, "access_evidence": str, "extractor": str, "fetched_at": str, "final_url": str, "requested_url": str, "sha256": str})

researcher_read_item_result = TypedDict("researcher_read_item_result", {"detail": NotRequired[str], "markdown": NotRequired[str], "metadata": researcher_read_item_result_metadata, "read_depth_note": str, "reason": NotRequired[str], "section": NotRequired[str], "sections": None | list[researcher_read_item_result_sections], "source": NotRequired[None | researcher_read_item_result_source], "status": str, "text_bytes": NotRequired[int], "truncated": NotRequired[bool]})
async def tools.researcher.read_item(*, item: str, venue: str, section: str = None) -> researcher_read_item_result: ...
# Read one corpus item's metadata and, when the private text store has it, one Markdown section (default _full, capped per response). Third-party text is private and shown only to authenticated agents. When text is absent or the store is unavailable the result has status unavailable with a reason and the outline of sections that do exist; no text is invented and no public copy is substituted.

## researcher.read_public_source
async def tools.researcher.read_public_source(*, url: str, expected_text_sha256: str = None, limit: int = None, offset: int = None) -> researcher_read_public_source_result: ...
# Read one direct public HTTPS HTML/plain-text page (1 MiB) or PDF (10 MiB), with robots and network protection, no redirects, login, paywall bypass, ingestion or retained downloads. Whole read is bounded to 45 seconds; PDF extraction to 30 seconds, 100 pages and 8 MiB text, with no decryption or OCR. Returns untrusted text, extractor provenance and up to 100 HTML link metadata records, never fetches links. offset/limit count Unicode characters; limit defaults to 12000, max 24000. Each pagination call refetches; compare text_sha256 and pass expected_text_sha256 to reject changed text. content_sha256 hashes the raw body; source_pdf_sha256 hashes raw PDF bytes. Does not verify call requirements or licenses.
from typing import Any, Literal, NotRequired, TypedDict

researcher_read_public_source_result_links = TypedDict("researcher_read_public_source_result_links", {"text": str, "url": str})

researcher_read_public_source_result = TypedDict("researcher_read_public_source_result", {"content_sha256": str, "content_type": str, "extractor": str, "final_url": str, "links": None | list[researcher_read_public_source_result_links], "next_offset": None | int, "notice": str, "offset": int, "pdf_pages": NotRequired[int], "read_at": str, "representation": str, "requested_url": str, "source_pdf_sha256": NotRequired[str], "text_excerpt": str, "text_sha256": str, "title": str, "total_characters": int, "truncated": bool})
async def tools.researcher.read_public_source(*, url: str, expected_text_sha256: str = None, limit: int = None, offset: int = None) -> researcher_read_public_source_result: ...
# Read one direct public HTTPS HTML/plain-text page (1 MiB) or PDF (10 MiB), with robots and network protection, no redirects, login, paywall bypass, ingestion or retained downloads. Whole read is bounded to 45 seconds; PDF extraction to 30 seconds, 100 pages and 8 MiB text, with no decryption or OCR. Returns untrusted text, extractor provenance and up to 100 HTML link metadata records, never fetches links. offset/limit count Unicode characters; limit defaults to 12000, max 24000. Each pagination call refetches; compare text_sha256 and pass expected_text_sha256 to reject changed text. content_sha256 hashes the raw body; source_pdf_sha256 hashes raw PDF bytes. Does not verify call requirements or licenses.

## researcher.search
async def tools.researcher.search(*, query: str, cursor: str = None, limit: int = None, scope: str = None, venue: str = None) -> researcher_search_result: ...
# Search Mongo-backed pieces, venues, accepted-paper metadata, and facts. Paper metadata uses native whole-word OR search in titles and abstracts; double quotes require a phrase and minus excludes a word, without stemming. Other scopes retain their own matching. Results are bounded.
from typing import Any, Literal, NotRequired, TypedDict

researcher_search_result_results = TypedDict("researcher_search_result_results", {"id": str, "text": str, "title": str, "url": NotRequired[str]})

researcher_search_result = TypedDict("researcher_search_result", {"next_action": NotRequired[str], "next_cursor": NotRequired[str], "results": None | list[researcher_search_result_results], "truncated": NotRequired[bool]})
async def tools.researcher.search(*, query: str, cursor: str = None, limit: int = None, scope: str = None, venue: str = None) -> researcher_search_result: ...
# Search Mongo-backed pieces, venues, accepted-paper metadata, and facts. Paper metadata uses native whole-word OR search in titles and abstracts; double quotes require a phrase and minus excludes a word, without stemming. Other scopes retain their own matching. Results are bounded.

## researcher.search_corpus
async def tools.researcher.search_corpus(*, q: str, cursor: str = None, limit: int = None, mode: str = None, track: str = None, venue: str = None) -> researcher_search_corpus_result: ...
# Search the imported corpus by title and abstract metadata only. With venue set, q may be empty to browse all its stored items in bounded pages. mode=words (default) is native whole-word search: several words match any of them, double quotes require a phrase, a leading minus excludes a word, no stemming. mode=meaning is not supported and returns status unsupported; it never falls back to words. venue accepts a registry or corpus key. The read depth on each item is a label copied from source metadata, not proof that text is stored; use read_item to find out. Pass next_cursor back with the same filters to continue.
from typing import Any, Literal, NotRequired, TypedDict

researcher_search_corpus_result_items = TypedDict("researcher_search_corpus_result_items", {"item": str, "read_depth_label": NotRequired[str], "snippet": NotRequired[str], "snippet_source": str, "text_reference_recorded": bool, "title": str, "track": NotRequired[str], "url": NotRequired[str], "venue": str, "year": NotRequired[int]})

researcher_search_corpus_result = TypedDict("researcher_search_corpus_result", {"items": None | list[researcher_search_corpus_result_items], "mode": str, "next_cursor": NotRequired[str], "read_depth_basis": str, "reason": NotRequired[str], "status": str})
async def tools.researcher.search_corpus(*, q: str, cursor: str = None, limit: int = None, mode: str = None, track: str = None, venue: str = None) -> researcher_search_corpus_result: ...
# Search the imported corpus by title and abstract metadata only. With venue set, q may be empty to browse all its stored items in bounded pages. mode=words (default) is native whole-word search: several words match any of them, double quotes require a phrase, a leading minus excludes a word, no stemming. mode=meaning is not supported and returns status unsupported; it never falls back to words. venue accepts a registry or corpus key. The read depth on each item is a label copied from source metadata, not proof that text is stored; use read_item to find out. Pass next_cursor back with the same filters to continue.

## researcher.search_venues
async def tools.researcher.search_venues(*, applying: None | bool = None, cursor: str = None, lane: str = None, limit: int = None, q: str = None, tier: int = None) -> researcher_search_venues_result: ...
# Search the venue registry by name or key, with optional tier (1-3), lane (a track's workflow lane) and applying filters. Lists every scholarly grade unless narrowed. Returns bounded venue summaries with their tracks and an opaque next_cursor; pass it back with the same filters to continue.
from typing import Any, Literal, NotRequired, TypedDict

researcher_search_venues_result_venues_tracks = TypedDict("researcher_search_venues_result_venues_tracks", {"key": str, "kind": str, "lane": str, "name": str})

researcher_search_venues_result_venues = TypedDict("researcher_search_venues_result_venues", {"applying": bool, "corpus_items": int, "corpus_key": NotRequired[str], "deadline": NotRequired[str], "key": str, "name": str, "scholarly_grade": NotRequired[str], "tier": NotRequired[int], "tier_label": NotRequired[str], "tracks": None | list[researcher_search_venues_result_venues_tracks], "tracks_omitted": NotRequired[bool], "url": NotRequired[str]})

researcher_search_venues_result = TypedDict("researcher_search_venues_result", {"next_cursor": NotRequired[str], "total_matching": int, "venues": None | list[researcher_search_venues_result_venues]})
async def tools.researcher.search_venues(*, applying: None | bool = None, cursor: str = None, lane: str = None, limit: int = None, q: str = None, tier: int = None) -> researcher_search_venues_result: ...
# Search the venue registry by name or key, with optional tier (1-3), lane (a track's workflow lane) and applying filters. Lists every scholarly grade unless narrowed. Returns bounded venue summaries with their tracks and an opaque next_cursor; pass it back with the same filters to continue.

