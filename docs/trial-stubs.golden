## researcher.find_corpus_sources
async def tools.researcher.find_corpus_sources(*, item: str, venue: str, provider: str = None) -> researcher_find_corpus_sources_result: ...
# Discover at most five metadata records each from Crossref and OpenAlex for one existing accepted corpus item. Requires registry venue and item; optional provider=both (default), crossref or openalex. Uses stored public title only for anonymous provider searches. Reports exact normalized title/year/full-author identity comparisons and provider-reported DOI, landing and PDF links. Unknown author/year fields never confirm identity. OA is only a provider claim; access and licenses remain independently unverified. No article body download, credential use, retries, paywall bypass, or corpus mutation. Provider failures are explicit and partial results are retained.
