{
  "name": "ui",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lint": "oxlint",
    "typecheck": "tsr generate && tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "build": "vite build && tsc --noEmit && bun run size",
    "size": "bun scripts/check-size.ts",
    "stage": "bun scripts/stage.ts",
    "preview": "vite preview",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"scripts/*.ts\" vite.config.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/m-plus-1p": "^5.3.0",
    "@tailwindcss/vite": "^4",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-router": "^1.170.46",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.23.0",
    "simple-icons": "^16.37.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/core": "7",
    "@playwright/test": "^1.65.1",
    "@rolldown/plugin-babel": "^0.3.1",
    "@tanstack/router-cli": "^1.168.0",
    "@tanstack/router-plugin": "^1.169.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/babel__core": "^7.20.5",
    "@types/bun": "^1.4.4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "babel-plugin-react-compiler": "^1.0.0",
    "jsdom": "^31.0.1",
    "oxlint": "^1.93.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "7",
    "vite": "^8",
    "vitest": "^5.1.0"
  }
}
