{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "bundler", "jsx": "react-jsx",
    "types": ["vite/client", "bun"], "strict": true, "noEmit": true,
    "skipLibCheck": true, "verbatimModuleSyntax": true, "erasableSyntaxOnly": true,
    "noUnusedLocals": true, "noUnusedParameters": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src", "scripts", "e2e", "vite.config.ts", "playwright.config.ts"]
}
